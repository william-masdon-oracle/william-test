page 9253 (
    name: Reserved Public IPs
    alias: RESERVED-PUBLIC-IPS
    title: Reserved Public IPs
    appearance {
        pageTemplate: @standard-trustarc
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @superrrrr-user
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region reserved-public-ips (
        name: Reserved Public IPs
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.id
                     , p.name
                     , p.ip_address
                     , p.dns_entry
                     , case
                           when p.reservation_id is null then 'Available'
                           else 'In Use'
                       end as allocation_status
                     , p.reservation_id
                     , p.last_reservation_id
                     , p.active_flg
                     , t.tenancy_name
                     , r.region_identifier
                     , p.last_used_on
                     , p.allocated_on
                     , p.released_on
                     , p.last_oci_check_on
                     , p.last_oci_lifecycle_state
                     , p.last_oci_assigned_entity_id
                     , p.ip_ocid
                     , p.cert_common_name
                     , p.cert_ocid
                     , p.ca_bundle_ocid
                  from ll_reserved_public_ips p
                  left join ll_tenancies t
                    on t.id = p.tenancy_id
                  left join ll_oci_regions r
                    on r.id = p.region_id
                 order by p.last_used_on nulls first
                        , p.id
                ```
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: scroll
            showTotalCount: true
        }
        messages {
            whenNoDataFound: No reserved public IPs have been loaded.
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
            ]
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @ID
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @NAME
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @IP_ADDRESS
                layout {
                    sequence: 3
                }
            )

            displayColumn (
